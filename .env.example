# ============================================================
# Environment Variables Template
# ============================================================
# Kopiere diese Datei zu '.env' und trage deine API-Keys ein.
# Diese Datei darf NICHT eingecheckt werden (siehe .gitignore).

# ------------------------------------------------------------
# Commercial Providers (für Golden Standards & Benchmarks)
# ------------------------------------------------------------

# Mistral AI (Empfohlen für Golden Standard)
# https://console.mistral.ai/
MISTRAL_API_KEY=your-mistral-api-key-here

# Anthropic (Claude)
# https://console.anthropic.com/
# ANTHROPIC_API_KEY=sk-ant-your-key-here

# OpenAI (GPT-4o, o1-mini)
# https://platform.openai.com/
OPENAI_API_KEY=sk-your-key-here
# OPENAI_API_KEY=sk-your-key-here

# ------------------------------------------------------------
# Usage
# ------------------------------------------------------------
# 1. Kopiere diese Datei: cp .env.example .env
# 2. Füge deine API-Keys ein
# 3. Die Keys werden automatisch von den Scripts geladen (via python-dotenv)

