# ============================================================
# Golden Standard Models Configuration (Example)
# ============================================================
# Diese Datei definiert spezifische Modell-Konfigurationen für
# die Erstellung von Golden Standards.
#
# Kopiere diese Datei zu 'golden_standard_models.yaml', um
# eigene Konfigurationen zu nutzen.

models:
  - provider: mistral
    model: mistral-large-latest
    description: "Mistral Large Reference"
  
  - provider: anthropic
    model: claude-3-5-sonnet-20241022
    description: "Claude 3.5 Sonnet Reference"
