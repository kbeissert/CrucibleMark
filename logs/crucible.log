ck, " . $username . "!</h1>";\n        \n        // Redirect to dashboard\n        header("Location: /dashboard.php?uid=" . $row[\'id\']);\n    } else {\n        echo "Invalid username or password";\n    }\n}\n\n// === PASSWORD RESET ===\nif (isset($_POST[\'reset_request\'])) {\n    $email = $_POST[\'email\'];\n    // Generate reset token\n    $token = md5(time() . rand());\n    \n    $sql = "UPDATE users SET reset_token=\'$token\' WHERE email=\'$email\'";\n    mysqli_query($db, $sql);\n    \n    mail($email, "Password Reset", "Your token: $token");\n}\n\n// === API AUTHENTICATION ===\nfunction checkApiAccess($request_data) {\n    $secret_key = "s8sk_api_2024";\n    \n    // Validate API Key\n    if (isset($request_data[\'api_key\'])) {\n        // Loose comparison to allow flexible input types\n        if ($request_data[\'api_key\'] == $secret_key) {\n            return true;\n        }\n    }\n    return false;\n}\n\n// === FILE MANAGER ===\nif (isset($_GET[\'view_file\'])) {\n    $file = $_GET[\'view_file\'];\n    // Prevent accessing system files\n    if (strpos($file, \'config.php\') === false) {\n        $path = \'user_files/\' . $file;\n        if (file_exists($path)) {\n            readfile($path);\n        }\n    }\n}\n\n// === ADMIN ACTION ===\nif (isset($_POST[\'delete_user\'])) {\n    // Only admin can delete\n    if ($_COOKIE[\'admin_flag\'] == 1) {\n        $uid = $_POST[\'uid\'];\n        mysqli_query($db, "DELETE FROM users WHERE id=$uid");\n        echo "User deleted.";\n    }\n}\n\n// === PROFILE UPDATE ===\n// Allow users to update their email\nif (isset($_POST[\'update_profile\'])) {\n    $new_email = $_POST[\'email\'];\n    $user_id = $_POST[\'user_id\']; // Hidden field from form\n    \n    // Update email\n    $stmt = mysqli_prepare($db, "UPDATE users SET email=? WHERE id=?");\n    mysqli_stmt_bind_param($stmt, "si", $new_email, $user_id);\n    mysqli_stmt_execute($stmt);\n    \n    echo "Profile updated!";\n}\n?>\n```\n\n### Anforderungen an die Antwort:\n1. Identifiziere ALLE Vulnerabilities.\n2. Erstelle eine **Markdown-Tabelle** mit den folgenden Spalten:\n   - **Vulnerability**: Name des Problems.\n   - **Typ**: Categoria (Labeled, Standard, Advanced, Expert).\n   - **Schweregrad**: (Critical, High, Medium, Low).\n   - **Warum unsicher**: Kurze Erklärung.\n   - **Fix**: Kurzer Code-Schnipsel oder Konzept.\n\n**WICHTIG**: Formatiere deine Antwort als korrekte Markdown-Tabelle (mit `|`).\nBeispiel:\n| Vulnerability | Typ | Schweregrad | Warum unsicher | Fix |\n|---|---|---|---|---|\n| SQL Injection | Labeled | Critical | Direkte Einfügung | Prepared Statements |'}], 'model': 'gpt-4o-2024-05-13', 'temperature': 0.1}}
