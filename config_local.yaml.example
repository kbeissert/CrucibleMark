# ============================================================
# Local Configuration Override (Example)
# ============================================================
# Kopiere diese Datei zu 'config_local.yaml', um lokale Einstellungen
# vorzunehmen, die nicht in git eingecheckt werden sollen.
#
# Die Einstellungen hier überschreiben die Werte in benchmark_config.yaml.

# Beispiel: Anderen Golden Standard Provider nutzen
# golden_standard:
#   provider: "anthropic"
#   model: "claude-3-5-sonnet-20241022"

# Beispiel: Bestimmte Module deaktivieren
# modules:
#   code_quality:
#     enabled: false
