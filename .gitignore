# Python & Virtual Env
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
.mypy_cache/
mypy_report.txt

# Local Environment & Logs
.env
llm_requests.log
logs/
.continue/

# Configuration (Local overrides)
config_local.yaml

# Outputs & Artifacts
backups/
_backup_old/

# Benchmark Results (Ignore volatile/generated files)
benchmark_scores/*.csv
benchmark_scores/*.json
# Exception: Allow manually created snapshots or golden references in strict subfolders if needed
!benchmark_scores/snapshots/
!benchmark_scores/references/
# Test Corpus — PRIVAT: Testprompts und Golden Standards nicht veröffentlichen
# (Kontaminationsschutz: Labs scrapen öffentliche Repos für Pre-Training-Daten)
benchmark_modules/**/assets/
benchmark_modules/**/assets_v3_backup/
# Golden Standards (Must be committed as they are the source of truth)
# Ensure we don't accidentally ignore json files inside specific validated folders
!golden_standards/**/*.json

# Ignore all contents in outputs (Runtime logs)
outputs/*
# We want to keep the folder structure, so we un-ignore the folders...
!outputs/runs/
!outputs/comparisons/
# ...but ignore the actual content inside them
outputs/runs/*
outputs/comparisons/*
# Finally allow .gitkeep to preserve folder structure
!outputs/**/.gitkeep

# Modell-Reviews (öffentliches Produkt — in docs/reviews/ versioniert)
# docs/reviews/ ist explizit NICHT ignoriert

# IDE & OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Auto-generierter LiteLLM Preis-Cache (machine-generated, nicht committen)
config/.prices_cache.json
_smoke_test.py
benchmark_config.yaml

# Judge-Prompt — nicht öffentlich (Kontaminationsschutz)
config/meta_reviewer_prompt.yaml

# Memory Bank — interne Projektplanung, nicht öffentlich
memory-bank/

# Debug-Artefakte
.temp_prompt.yaml
last_failed_raw.txt

# Internes Refactoring-Backlog — nicht öffentlich
REF_TODO.md

# Lokale AI-Assistent-Konfiguration
.clinerules/
.prompts/

# Web Export
web_export/
